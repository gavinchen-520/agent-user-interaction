{
  "name": "agent-ui-interaction",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "opencode-plugin",
    "opencode-v2-plugin"
  ],
  "scripts": {
    "test": "bun test --path-ignore-patterns \"tests/e2e/**\"",
    "test:e2e": "bunx playwright test",
    "test:v2": "bun run --cwd opencode-v2-plugin test",
    "typecheck": "bun run --cwd opencode-plugin typecheck",
    "typecheck:v2": "bun run --cwd opencode-v2-plugin typecheck",
    "build": "bun run --cwd opencode-plugin build",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run typecheck:v2 && biome check . && bun run test && bun run test:v2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@playwright/test": "1.63.0",
    "bun-types": "1.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.2"
  }
}
