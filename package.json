{
  "name": "agent-ui-interaction",
  "private": true,
  "workspaces": [
    "opencode-plugin"
  ],
  "scripts": {
    "test": "bun test --path-ignore-patterns \"tests/e2e/**\"",
    "test:e2e": "bunx playwright test",
    "typecheck": "bun run --cwd opencode-plugin typecheck",
    "build": "bun run --cwd opencode-plugin build",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "bun-types": "latest",
    "typescript": "^6.0.2"
  }
}
